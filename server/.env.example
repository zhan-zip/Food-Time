# ========== 数据库 ==========
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/food_time

# ========== JWT ==========
JWT_SECRET=your-jwt-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ========== DeepSeek API ==========
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ========== Qwen VL API ==========
QWEN_API_KEY=sk-your-qwen-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-vl-max

# ========== 邮件服务 (SMTP) ==========
# 推荐 QQ邮箱：开启 SMTP 服务后获取「授权码」（非登录密码）
# QQ邮箱：SMTP_HOST=smtp.qq.com  SMTP_PORT=587/465
# 163邮箱：SMTP_HOST=smtp.163.com  SMTP_PORT=465
# 如不配置，验证码将打印到后端控制台（开发用）
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your-email@qq.com
SMTP_PASSWORD=your-smtp-auth-code
SMTP_FROM=your-email@qq.com

# ========== CORS ==========
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ========== 管理员 ==========
ADMIN_EMAIL=admin@food-time.com
# 注意：admin123 已被启动安全校验拒绝，请务必替换为强随机密码
ADMIN_PASSWORD=<强随机密码>

# ========== 图片服务 ==========
# Pixabay 免费图库 Key（https://pixabay.com/api/docs/），用于首页/广场菜品图
PIXABAY_API_KEY=

# ========== 调试 ==========
DEBUG=true
